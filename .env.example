# ─────────────────────────────────────────────────────────────
# Supabase — crea un proyecto en https://supabase.com y copia estos valores
# desde Project Settings → API
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo servidor — NUNCA la expongas en el cliente. Se usa para importar
# invitados y para el panel admin (bypassa RLS).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ─────────────────────────────────────────────────────────────
# Panel de administración (/admin)
# ─────────────────────────────────────────────────────────────
# Contraseña única para entrar al panel (login simple por cookie firmada)
ADMIN_PASSWORD=cambia-esta-clave
# Secreto para firmar la cookie de sesión del admin (usa una cadena larga aleatoria)
ADMIN_SESSION_SECRET=genera-una-cadena-larga-y-aleatoria

# ─────────────────────────────────────────────────────────────
# Sitio
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://boda.albertyuly.com

# ─────────────────────────────────────────────────────────────
# Modo demo — si no configuras Supabase, la app funciona con datos de
# ejemplo (útil para ver el diseño sin base de datos). Ponlo en "false"
# cuando conectes Supabase de verdad.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEMO_MODE=true
